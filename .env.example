DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/starstyle"
SESSION_SECRET="at-least-32-random-characters"
# E-Mail-Versand von Angeboten/Rechnungen (optional)
SMTP_HOST="smtp.example.de"
SMTP_PORT="587"
SMTP_USER="info@startstyle.de"
SMTP_PASS=""
SMTP_FROM="Start Style <info@startstyle.de>"
SMTP_BCC=""
# KI-Funktionen (optional): Belege auslesen, Fragen in Alltagssprache, ausführlicher Monatsbericht
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"
# Shopify (Zugangsdaten werden im Programm unter „Shops“ eingetragen)
# APP_URL="https://star-style.onrender.com"   # auf Render automatisch über RENDER_EXTERNAL_URL
SHOPIFY_API_VERSION="2026-07"
# SHOPIFY_WORKER="off"   # Hintergrund-Abgleich abschalten (z. B. lokal)
